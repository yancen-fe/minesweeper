{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "扫雷",
  "version": "1.1.1",
  "identifier": "com.yancen.minesweeper.windows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "扫雷",
        "width": 430,
        "height": 550,
        "minWidth": 430,
        "minHeight": 550,
        "dragDropEnabled": false,
        "resizable": false,
        "maximizable": false,
        "maxWidth": 430,
        "maxHeight": 550
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      },
      "allowDowngrades": true
    }
  }
}
